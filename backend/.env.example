# Monday.com Personal API Token
MONDAY_API_TOKEN=your_monday_api_token_here

# Monday.com Target Board IDs (Optional: dynamic name pattern matching is used if left blank)
DEALS_BOARD_ID=5030218814
WORK_ORDERS_BOARD_ID=5030219591

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Force mock modes (ignores token checks, useful to override global system keys)
FORCE_MONDAY_MOCK=False
FORCE_OPENAI_MOCK=False

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# In-Memory Cache TTL in seconds (default 5 minutes)
CACHE_TTL_SECONDS=300
